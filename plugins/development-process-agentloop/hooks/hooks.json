{
  "description": "Load active AgentLoop state and guard premature edits or completion.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/scripts/agentloop.py\" hook session-start",
            "statusMessage": "Loading AgentLoop state",
            "additionalContextLimit": 600
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^apply_patch$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/scripts/agentloop.py\" hook pre-tool",
            "statusMessage": "Checking AgentLoop Gate"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/scripts/agentloop.py\" hook stop",
            "statusMessage": "Checking AgentLoop completion"
          }
        ]
      }
    ]
  }
}
