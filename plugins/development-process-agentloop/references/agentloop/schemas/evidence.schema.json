{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentloop.local/schemas/evidence.schema.json",
  "title": "AgentLoop evidence.yaml",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "loop_id", "runs"],
  "properties": {
    "schema_version": {"const": 1},
    "loop_id": {"type": "string", "pattern": "^al-[0-9]{8}-[0-9]{3}$"},
    "runs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidence_id", "requirement_version", "executor", "command", "result", "validity", "code_commit", "environment", "started_at", "ended_at", "duration_ms", "exit_code"],
        "properties": {
          "evidence_id": {"type": "string"},
          "flow_id": {"type": ["string", "null"]},
          "check_id": {"type": ["string", "null"]},
          "subflow_id": {"type": ["string", "null"]},
          "requirement_version": {"type": "integer", "minimum": 1},
          "executor": {"enum": ["code", "ui", "command"]},
          "command": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "result": {"enum": ["passed", "failed", "blocked"]},
          "exit_code": {"type": "integer"},
          "counts": {
            "type": "object",
            "required": ["passed", "failed", "skipped"],
            "properties": {
              "passed": {"type": "integer", "minimum": 0},
              "failed": {"type": "integer", "minimum": 0},
              "skipped": {"type": "integer", "minimum": 0}
            },
            "additionalProperties": false
          },
          "validity": {"enum": ["active", "stale"]},
          "code_commit": {"type": "string", "minLength": 1},
          "environment": {"type": "string", "minLength": 1},
          "started_at": {"type": "string", "format": "date-time"},
          "ended_at": {"type": "string", "format": "date-time"},
          "duration_ms": {"type": "integer", "minimum": 0},
          "stdout_path": {"type": ["string", "null"]},
          "stderr_path": {"type": ["string", "null"]},
          "coverage": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "prototype_path", "route", "region_id", "interaction_id",
                "acceptance_id", "automation_step", "evidence_paths"
              ],
              "properties": {
                "prototype_path": {"type": "string", "minLength": 1},
                "route": {"type": "string", "minLength": 1},
                "region_id": {"type": "string", "minLength": 1},
                "interaction_id": {"type": "string", "minLength": 1},
                "acceptance_id": {"type": "string", "minLength": 1},
                "automation_step": {"type": "string", "minLength": 1},
                "evidence_paths": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
              }
            }
          },
          "visual": {
            "type": "object",
            "additionalProperties": false,
            "required": ["viewport", "comparison", "allowed_differences", "pass_criteria", "references", "result"],
            "properties": {
              "viewport": {
                "type": "object",
                "additionalProperties": false,
                "required": ["width", "height"],
                "properties": {
                  "width": {"type": "integer", "minimum": 1},
                  "height": {"type": "integer", "minimum": 1}
                }
              },
              "comparison": {"enum": ["dom", "screenshot", "both"]},
              "allowed_differences": {"type": "array", "items": {"type": "string"}},
              "pass_criteria": {"type": "string", "minLength": 1},
              "references": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["prototype_path", "reference_path", "implementation_path"],
                  "properties": {
                    "prototype_path": {"type": "string", "minLength": 1},
                    "reference_path": {"type": "string", "minLength": 1},
                    "implementation_path": {"type": "string", "minLength": 1}
                  }
                }
              },
              "result": {"enum": ["passed", "failed"]}
            }
          },
          "artifacts": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["path", "sha256"],
              "properties": {
                "path": {"type": "string"},
                "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
              },
              "additionalProperties": false
            }
          }
        },
        "oneOf": [
          {"required": ["flow_id"], "properties": {"flow_id": {"type": "string"}, "check_id": {"type": "null"}}},
          {"required": ["check_id"], "properties": {"check_id": {"type": "string"}, "flow_id": {"type": "null"}}}
        ]
      }
    }
  }
}
