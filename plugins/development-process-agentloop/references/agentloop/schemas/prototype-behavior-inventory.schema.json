{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentloop.local/schemas/prototype-behavior-inventory.schema.json",
  "title": "AgentLoop prototype behavior inventory",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "loop_id", "requirement_version", "scanner", "sources"],
  "properties": {
    "schema_version": {"const": 1},
    "loop_id": {"type": "string", "pattern": "^al-[0-9]{8}-[0-9]{3}$"},
    "requirement_version": {"type": "integer", "minimum": 1},
    "scanner": {"const": "agentloop-static-v1"},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["prototype_path", "sha256", "behaviors"],
        "properties": {
          "prototype_path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "behaviors": {
            "type": "array",
            "minItems": 0,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["behavior_id", "kind", "event", "source_line", "target"],
              "properties": {
                "behavior_id": {"type": "string", "minLength": 1},
                "kind": {"enum": ["event", "navigation"]},
                "event": {"enum": ["click", "submit", "change", "input", "navigation"]},
                "source_line": {"type": "integer", "minimum": 1},
                "target": {"type": "string", "minLength": 1}
              }
            }
          }
        }
      }
    }
  }
}
