{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentloop.local/schemas/prototype-matrix.schema.json",
  "title": "AgentLoop prototype implementation matrix",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "loop_id", "requirement_version", "pages"],
  "properties": {
    "schema_version": {"const": 1},
    "loop_id": {"type": "string", "pattern": "^al-[0-9]{8}-[0-9]{3}$"},
    "requirement_version": {"type": "integer", "minimum": 1},
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "prototype_path", "route", "regions", "interactions", "states",
          "data_sources", "permissions", "responsive", "allowed_deviations"
        ],
        "properties": {
          "prototype_path": {"type": "string", "minLength": 1},
          "route": {"type": "string", "minLength": 1},
          "subflow_id": {"type": ["string", "null"]},
          "regions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["region_id", "layout", "required_controls"],
              "properties": {
                "region_id": {"type": "string", "minLength": 1},
                "layout": {"type": "string", "minLength": 1},
                "required_controls": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["control_id", "description"],
                    "properties": {
                      "control_id": {"type": "string", "minLength": 1},
                      "description": {"type": "string", "minLength": 1}
                    }
                  }
                }
              }
            }
          },
          "interactions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["interaction_id", "region_id", "control_id", "action", "state_change", "acceptance_ids"],
              "properties": {
                "interaction_id": {"type": "string", "minLength": 1},
                "region_id": {"type": "string", "minLength": 1},
                "control_id": {"type": "string", "minLength": 1},
                "action": {"type": "string", "minLength": 1},
                "state_change": {"type": "string", "minLength": 1},
                "acceptance_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
              }
            }
          },
          "states": {
            "type": "object",
            "additionalProperties": false,
            "required": ["loading", "empty", "error", "unauthorized"],
            "properties": {
              "loading": {"type": "string", "minLength": 1},
              "empty": {"type": "string", "minLength": 1},
              "error": {"type": "string", "minLength": 1},
              "unauthorized": {"type": "string", "minLength": 1}
            }
          },
          "data_sources": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "permissions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "responsive": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "allowed_deviations": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["content", "reason"],
              "properties": {
                "content": {"type": "string", "minLength": 1},
                "reason": {"type": "string", "minLength": 1}
              }
            }
          }
        }
      }
    }
  }
}
