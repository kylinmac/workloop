{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentloop.local/schemas/development-contract.schema.json",
  "title": "Workloop collaborative development contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "loop_id", "requirement_version", "status", "participants", "api", "data", "behavior", "acceptance"],
  "properties": {
    "schema_version": {"const": 1},
    "loop_id": {"type": "string", "pattern": "^al-[0-9]{8}-[0-9]{3}$"},
    "requirement_version": {"type": "integer", "minimum": 1},
    "status": {"enum": ["draft", "confirmed"]},
    "participants": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["actor", "responsibilities"],
        "properties": {
          "actor": {"type": "string", "minLength": 1},
          "responsibilities": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "api": {"type": "array", "items": {"$ref": "#/$defs/api_contract"}},
    "data": {"type": "array", "items": {"$ref": "#/$defs/data_contract"}},
    "behavior": {"type": "array", "items": {"$ref": "#/$defs/behavior_contract"}},
    "acceptance": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/acceptance_contract"}}
  },
  "anyOf": [
    {"properties": {"api": {"minItems": 1}}},
    {"properties": {"data": {"minItems": 1}}},
    {"properties": {"behavior": {"minItems": 1}}}
  ],
  "$defs": {
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type", "required", "meaning"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "type": {"type": "string", "minLength": 1},
        "required": {"type": "boolean"},
        "meaning": {"type": "string", "minLength": 1}
      }
    },
    "api_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_id", "method", "path", "request", "response", "errors"],
      "properties": {
        "contract_id": {"type": "string", "pattern": "^API-[0-9]{2,}$"},
        "method": {"enum": ["GET", "POST", "PUT", "PATCH", "DELETE"]},
        "path": {"type": "string", "pattern": "^/"},
        "request": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/field"}},
        "response": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/field"}},
        "errors": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code", "meaning"],
            "properties": {
              "code": {"type": "string", "minLength": 1},
              "meaning": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "data_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_id", "name", "meaning", "values"],
      "properties": {
        "contract_id": {"type": "string", "pattern": "^DATA-[0-9]{2,}$"},
        "name": {"type": "string", "minLength": 1},
        "meaning": {"type": "string", "minLength": 1},
        "values": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["value", "meaning"],
            "properties": {
              "value": {"type": ["string", "number", "boolean"]},
              "meaning": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "behavior_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_id", "name", "trigger", "condition", "outcome"],
      "properties": {
        "contract_id": {"type": "string", "pattern": "^BEH-[0-9]{2,}$"},
        "name": {"type": "string", "minLength": 1},
        "trigger": {"type": "string", "minLength": 1},
        "condition": {"type": "string", "minLength": 1},
        "outcome": {"type": "string", "minLength": 1}
      }
    },
    "acceptance_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_id", "acceptance_ids", "scenario", "given", "when", "then"],
      "properties": {
        "contract_id": {"type": "string", "pattern": "^ACC-[0-9]{2,}$"},
        "acceptance_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "scenario": {"type": "string", "minLength": 1},
        "given": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "when": {"type": "string", "minLength": 1},
        "then": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
