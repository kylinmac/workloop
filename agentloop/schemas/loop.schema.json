{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentloop.local/schemas/loop.schema.json",
  "title": "AgentLoop loop.yaml",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "loop_id", "loop_kind", "title", "execution_profile", "state",
    "requirement_version", "updated_at", "owners", "classification", "scope", "gates",
    "gate_events", "git", "routing", "files", "execution", "subflows", "child_loops",
    "integration_verification", "artifacts", "transitions"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "loop_id": {"type": "string", "pattern": "^al-[0-9]{8}-[0-9]{3}$"},
    "loop_kind": {"enum": ["delivery", "epic"]},
    "parent_loop_id": {"type": ["string", "null"]},
    "title": {"type": "string", "minLength": 1},
    "execution_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "status", "reason"],
      "properties": {
        "level": {"enum": ["trivial", "standard", "composite"]},
        "status": {"enum": ["provisional", "confirmed"]},
        "reason": {"type": "string", "minLength": 1},
        "qualifications": {
          "type": "object",
          "additionalProperties": false,
          "required": ["single_delivery_unit", "scope_known", "low_risk", "directly_observable", "concurrent_work"],
          "properties": {
            "single_delivery_unit": {"type": "boolean"},
            "scope_known": {"type": "boolean"},
            "low_risk": {"type": "boolean"},
            "directly_observable": {"type": "boolean"},
            "concurrent_work": {"type": "boolean"}
          }
        }
      }
    },
    "state": {
      "enum": [
        "draft", "clarifying", "awaiting_requirement_confirmation", "ready_for_development",
        "development_preparing", "developing", "ready_for_verification", "verifying",
        "orchestrating", "verified", "done", "blocked", "cancelled"
      ]
    },
    "requirement_version": {"type": "integer", "minimum": 1},
    "updated_at": {"type": "string", "format": "date-time"},
    "owners": {
      "type": "object",
      "additionalProperties": false,
      "required": ["coordination", "requirement", "development", "verification"],
      "properties": {
        "coordination": {"type": "string"},
        "requirement": {"type": "string"},
        "development": {"type": "string"},
        "verification": {"type": "string"}
      }
    },
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary_type", "tags"],
      "properties": {
        "control_version": {"enum": [1, 2]},
        "primary_type": {"enum": ["待确认", "从 0 建设", "新增能力", "修改现有行为", "缺陷修复", "内部改进", "迁移升级", "下线删除", "技术研究"]},
        "tags": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "basis": {"type": "string"},
        "obligations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["obligation_id", "kind", "requirement", "source", "status"],
            "properties": {
              "obligation_id": {"type": "string", "minLength": 1},
              "kind": {"type": "string", "minLength": 1},
              "requirement": {"type": "string", "minLength": 1},
              "source": {"type": "string", "minLength": 1},
              "status": {"const": "confirmed"}
            }
          }
        }
      }
    },
    "acceptance_obligations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["acceptance_id", "criterion", "source", "required", "implementation_paths", "verification"],
        "properties": {
          "acceptance_id": {"type": "string", "minLength": 1},
          "criterion": {"type": "string", "minLength": 1},
          "source": {"type": "string", "minLength": 1},
          "required": {"type": "boolean"},
          "implementation_paths": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          },
          "verification": {
            "oneOf": [
              {"type": "null"},
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["flow_id", "check_id", "executor", "subflow_id"],
                "properties": {
                  "flow_id": {"type": ["string", "null"]},
                  "check_id": {"type": ["string", "null"]},
                  "executor": {"enum": ["code", "ui", "command"]},
                  "subflow_id": {"type": ["string", "null"]}
                },
                "oneOf": [
                  {
                    "properties": {
                      "flow_id": {"type": "string", "minLength": 1},
                      "check_id": {"type": "null"}
                    }
                  },
                  {
                    "properties": {
                      "flow_id": {"type": "null"},
                      "check_id": {"type": "string", "minLength": 1}
                    }
                  }
                ]
              }
            ]
          }
        }
      }
    },
    "assumptions": {"type": "array", "items": {"$ref": "#/$defs/assumption"}},
    "decision_records": {"type": "array", "items": {"$ref": "#/$defs/decision_record"}},
    "knowledge_state": {"$ref": "#/$defs/knowledge_state"},
    "quality_metrics": {"type": "array", "items": {"$ref": "#/$defs/quality_metric"}},
    "failure_memory": {"type": "array", "items": {"$ref": "#/$defs/failure_record"}},
    "prototype": {"$ref": "#/$defs/prototype"},
    "integration_data": {"$ref": "#/$defs/integration_data"},
    "scope": {"$ref": "#/$defs/scope"},
    "gates": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/gate"},
      "required": ["requirement_confirmation", "routing_confirmation", "completion", "destructive_action"]
    },
    "gate_events": {
      "type": "array",
      "items": {"$ref": "#/$defs/gate_event"}
    },
    "git": {"$ref": "#/$defs/git"},
    "routing": {"$ref": "#/$defs/routing"},
    "files": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "work": {"type": "string"},
        "requirement": {"type": "string"},
        "development": {"type": "string"},
        "evidence": {"type": "string"},
        "development_assurance": {"type": "string"},
        "prototype_behavior_inventory": {"type": "string"},
        "prototype_matrix": {"type": "string"},
        "user_flow_slices": {"type": "string"},
        "api_contract": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["execution_id", "subflow_id", "step_id", "status", "operation", "inputs", "expected_outputs", "check", "idempotency", "attempt", "max_attempts", "last_error"],
      "properties": {
        "execution_id": {"type": ["string", "null"]},
        "subflow_id": {"type": ["string", "null"]},
        "step_id": {"type": ["string", "null"]},
        "status": {"type": ["string", "null"]},
        "operation": {"type": ["string", "null"]},
        "inputs": {"type": "array"},
        "expected_outputs": {"type": "array"},
        "check": {"type": ["string", "null"]},
        "idempotency": {"type": ["string", "null"]},
        "attempt": {"type": "integer", "minimum": 0},
        "max_attempts": {"type": "integer", "minimum": 1},
        "last_error": {"type": ["string", "null"]}
      }
    },
    "verification_control": {
      "type": ["object", "null"],
      "properties": {
        "failure_roundtrips": {"type": "integer", "minimum": 0},
        "max_failure_roundtrips": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "subflows": {
      "type": "array",
      "items": {"$ref": "#/$defs/subflow"}
    },
    "child_loops": {
      "type": "array",
      "items": {"$ref": "#/$defs/child_loop"}
    },
    "integration_verification": {"$ref": "#/$defs/integration_verification"},
    "verification_handoff": {"type": ["object", "null"]},
    "failure_handoff": {"type": ["object", "null"]},
    "artifacts": {"type": "array", "items": {"type": "object"}},
    "blocked": {
      "type": ["object", "null"],
      "properties": {
        "reason": {"type": ["string", "null"]},
        "owner": {"type": ["string", "null"]},
        "unblock_condition": {"type": ["string", "null"]},
        "resume_state": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "transitions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "to", "actor", "at", "requirement_version", "reason"],
        "properties": {
          "from": {"type": ["string", "null"]},
          "to": {"type": "string"},
          "subflow_id": {"type": ["string", "null"]},
          "actor": {"type": "string"},
          "at": {"type": "string", "format": "date-time"},
          "requirement_version": {"type": "integer", "minimum": 1},
          "git_commit": {"type": ["string", "null"]},
          "evidence": {"type": "array", "items": {"type": "string"}},
          "reason": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "allOf": [
    {
      "if": {
        "allOf": [
          {
            "properties": {
              "classification": {
                "properties": {"control_version": {"const": 2}},
                "required": ["control_version"]
              }
            }
          },
          {
            "properties": {"state": {"not": {"enum": ["done", "cancelled"]}}},
            "required": ["state"]
          }
        ]
      },
      "then": {
        "required": ["acceptance_obligations"],
        "properties": {
          "classification": {"required": ["basis", "obligations"]},
          "execution_profile": {"required": ["qualifications"]}
        }
      }
    },
    {
      "if": {"properties": {"loop_kind": {"const": "epic"}}},
      "then": {
        "properties": {
          "execution_profile": {"properties": {"level": {"const": "composite"}}},
          "subflows": {"maxItems": 0},
          "child_loops": {"minItems": 1}
        }
      }
    },
    {
      "if": {
        "properties": {
          "loop_kind": {"const": "delivery"},
          "execution_profile": {"properties": {"level": {"const": "composite"}}}
        }
      },
      "then": {
        "properties": {
          "subflows": {"minItems": 1},
          "child_loops": {"maxItems": 0}
        }
      }
    },
    {
      "if": {"properties": {"execution_profile": {"properties": {"level": {"const": "trivial"}}}}},
      "then": {
        "properties": {
          "files": {"required": ["work"]},
          "routing": {
            "properties": {
              "development": {"properties": {"main_flow": {"const": "quick-change"}}}
            }
          },
          "subflows": {"maxItems": 0},
          "child_loops": {"maxItems": 0}
        }
      }
    }
  ],
  "$defs": {
    "assumption": {
      "type": "object", "additionalProperties": false,
      "required": ["assumption_id", "statement", "impact", "status", "owner", "evidence", "updated_at"],
      "properties": {
        "assumption_id": {"type": "string", "pattern": "^ASM-[0-9]{2,}$"},
        "statement": {"type": "string", "minLength": 1},
        "impact": {"enum": ["non_blocking", "routing", "acceptance", "implementation", "verification"]},
        "status": {"enum": ["unverified", "confirmed", "rejected"]},
        "owner": {"type": "string", "minLength": 1},
        "evidence": {"type": ["string", "null"]},
        "updated_at": {"type": "string", "format": "date-time"}
      }
    },
    "decision_record": {
      "type": "object", "additionalProperties": false,
      "required": ["decision_id", "question", "options", "selected", "evidence", "rationale", "actor", "decided_at"],
      "properties": {
        "decision_id": {"type": "string", "pattern": "^DEC-[0-9]{2,}$"},
        "question": {"type": "string", "minLength": 1},
        "options": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "selected": {"type": "string", "minLength": 1},
        "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "rationale": {"type": "string", "minLength": 1},
        "actor": {"type": "string", "minLength": 1},
        "decided_at": {"type": "string", "format": "date-time"}
      }
    },
    "quality_metric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric_id", "name", "unit", "baseline", "target", "actual", "required", "status", "evidence", "owner", "updated_at"],
      "properties": {
        "metric_id": {"type": "string", "pattern": "^MET-[0-9]{2,}$"},
        "name": {"type": "string", "minLength": 1},
        "unit": {"type": "string", "minLength": 1},
        "baseline": {"type": ["number", "null"]},
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": ["operator", "value"],
          "properties": {
            "operator": {"enum": ["gte", "lte", "eq"]},
            "value": {"type": "number"}
          }
        },
        "actual": {"type": ["number", "null"]},
        "required": {"type": "boolean"},
        "status": {"enum": ["pending", "met", "missed"]},
        "evidence": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "owner": {"type": "string", "minLength": 1},
        "updated_at": {"type": "string", "format": "date-time"}
      },
      "allOf": [{
        "if": {"properties": {"status": {"const": "pending"}}},
        "then": {"properties": {"actual": {"type": "null"}, "evidence": {"maxItems": 0}}},
        "else": {"properties": {"actual": {"type": "number"}, "evidence": {"minItems": 1}}}
      }]
    },
    "failure_record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["failure_id", "evidence_id", "mistake", "actual_reason", "prevention", "assumption_ids", "decision_ids", "metric_ids", "unlinked_reason", "status", "verification_evidence", "actor", "recorded_at", "updated_at"],
      "properties": {
        "failure_id": {"type": "string", "pattern": "^FAI-[0-9]{2,}$"},
        "evidence_id": {"type": "string", "minLength": 1},
        "mistake": {"type": "string", "minLength": 1},
        "actual_reason": {"type": "string", "minLength": 1},
        "prevention": {"type": "string", "minLength": 1},
        "assumption_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^ASM-[0-9]{2,}$"}},
        "decision_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^DEC-[0-9]{2,}$"}},
        "metric_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^MET-[0-9]{2,}$"}},
        "unlinked_reason": {"type": ["string", "null"]},
        "status": {"enum": ["open", "prevention_verified"]},
        "verification_evidence": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "actor": {"type": "string", "minLength": 1},
        "recorded_at": {"type": "string", "format": "date-time"},
        "updated_at": {"type": "string", "format": "date-time"}
      },
      "allOf": [
        {
          "anyOf": [
            {"properties": {"assumption_ids": {"minItems": 1}}},
            {"properties": {"decision_ids": {"minItems": 1}}},
            {"properties": {"unlinked_reason": {"type": "string", "minLength": 1}}}
          ]
        },
        {
          "if": {"properties": {"status": {"const": "prevention_verified"}}},
          "then": {"properties": {"verification_evidence": {"minItems": 1}}},
          "else": {"properties": {"verification_evidence": {"maxItems": 0}}}
        }
      ]
    },
    "knowledge_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["known", "unknowns", "conflicts"],
      "properties": {
        "known": {"type": "array", "items": {"$ref": "#/$defs/known_knowledge"}},
        "unknowns": {"type": "array", "items": {"$ref": "#/$defs/unknown_knowledge"}},
        "conflicts": {"type": "array", "items": {"$ref": "#/$defs/conflicting_knowledge"}}
      }
    },
    "known_knowledge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["knowledge_id", "statement", "impact", "sources", "owner", "updated_at"],
      "properties": {
        "knowledge_id": {"type": "string", "pattern": "^KNO-[0-9]{2,}$"},
        "statement": {"type": "string", "minLength": 1},
        "impact": {"enum": ["non_blocking", "routing", "acceptance", "implementation", "verification"]},
        "sources": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "owner": {"type": "string", "minLength": 1},
        "updated_at": {"type": "string", "format": "date-time"}
      }
    },
    "unknown_knowledge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["knowledge_id", "question", "impact", "status", "resolution", "evidence", "owner", "updated_at"],
      "properties": {
        "knowledge_id": {"type": "string", "pattern": "^KNO-[0-9]{2,}$"},
        "question": {"type": "string", "minLength": 1},
        "impact": {"enum": ["non_blocking", "routing", "acceptance", "implementation", "verification"]},
        "status": {"enum": ["open", "resolved"]},
        "resolution": {"type": ["string", "null"]},
        "evidence": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "owner": {"type": "string", "minLength": 1},
        "updated_at": {"type": "string", "format": "date-time"}
      },
      "allOf": [{
        "if": {"properties": {"status": {"const": "resolved"}}},
        "then": {"properties": {"resolution": {"type": "string", "minLength": 1}, "evidence": {"minItems": 1}}},
        "else": {"properties": {"resolution": {"type": "null"}, "evidence": {"maxItems": 0}}}
      }]
    },
    "conflicting_knowledge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["knowledge_id", "statement", "impact", "claims", "status", "resolution", "evidence", "owner", "updated_at"],
      "properties": {
        "knowledge_id": {"type": "string", "pattern": "^KNO-[0-9]{2,}$"},
        "statement": {"type": "string", "minLength": 1},
        "impact": {"enum": ["non_blocking", "routing", "acceptance", "implementation", "verification"]},
        "claims": {
          "type": "array", "minItems": 2, "uniqueItems": true,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["source", "claim"],
            "properties": {
              "source": {"type": "string", "minLength": 1},
              "claim": {"type": "string", "minLength": 1}
            }
          }
        },
        "status": {"enum": ["open", "resolved"]},
        "resolution": {"type": ["string", "null"]},
        "evidence": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "owner": {"type": "string", "minLength": 1},
        "updated_at": {"type": "string", "format": "date-time"}
      },
      "allOf": [{
        "if": {"properties": {"status": {"const": "resolved"}}},
        "then": {"properties": {"resolution": {"type": "string", "minLength": 1}, "evidence": {"minItems": 1}}},
        "else": {"properties": {"resolution": {"type": "null"}, "evidence": {"maxItems": 0}}}
      }]
    },
    "integration_data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "reason", "frontend_routes", "backend_endpoints", "database_objects", "verification_flow_id"],
      "properties": {
        "required": {"type": "boolean"},
        "reason": {"type": "string", "minLength": 1},
        "frontend_routes": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "backend_endpoints": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "database_objects": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "verification_flow_id": {"type": ["string", "null"], "minLength": 1}
      },
      "allOf": [{
        "if": {"properties": {"required": {"const": true}}},
        "then": {
          "properties": {
            "frontend_routes": {"minItems": 1},
            "backend_endpoints": {"minItems": 1},
            "database_objects": {"minItems": 1},
            "verification_flow_id": {"type": "string"}
          }
        },
        "else": {
          "properties": {
            "frontend_routes": {"maxItems": 0},
            "backend_endpoints": {"maxItems": 0},
            "database_objects": {"maxItems": 0},
            "verification_flow_id": {"type": "null"}
          }
        }
      }]
    },
    "prototype": {
      "type": "object",
      "additionalProperties": false,
      "required": ["implementation_basis", "type", "fidelity", "pages"],
      "properties": {
        "implementation_basis": {"type": "boolean"},
        "type": {"enum": [null, "wireframe", "interactive", "high_fidelity"]},
        "fidelity": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["structure", "visual", "interaction", "content"],
          "properties": {
            "structure": {"enum": ["strict", "adjustable", "reference"]},
            "visual": {"enum": ["strict", "adjustable", "reference"]},
            "interaction": {"enum": ["strict", "adjustable", "reference"]},
            "content": {"enum": ["strict", "adjustable", "reference"]}
          }
        },
        "pages": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["prototype_path", "route", "acceptance", "allowed_deviations"],
            "properties": {
              "prototype_path": {"type": "string", "minLength": 1},
              "route": {"type": "string", "minLength": 1},
              "acceptance": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["acceptance_id", "criterion"],
                  "properties": {
                    "acceptance_id": {"type": "string", "minLength": 1},
                    "criterion": {"type": "string", "minLength": 1}
                  }
                }
              },
              "allowed_deviations": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["content", "reason"],
                  "properties": {
                    "content": {"type": "string", "minLength": 1},
                    "reason": {"type": "string", "minLength": 1}
                  }
                }
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {"properties": {"implementation_basis": {"const": true}}},
          "then": {
            "properties": {
              "type": {"enum": ["wireframe", "interactive", "high_fidelity"]},
              "fidelity": {"type": "object"},
              "pages": {"minItems": 1}
            }
          },
          "else": {
            "properties": {
              "type": {"type": "null"},
              "fidelity": {"type": "null"},
              "pages": {"maxItems": 0}
            }
          }
        }
      ]
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim", "paths", "interfaces", "db_objects", "states"],
      "properties": {
        "claim": {"enum": ["active", "released"]},
        "claimed_at": {"type": ["string", "null"], "format": "date-time"},
        "paths": {"type": "array", "items": {"type": "string"}},
        "interfaces": {"type": "array", "items": {"type": "string"}},
        "db_objects": {"type": "array", "items": {"type": "string"}},
        "states": {"type": "array", "items": {"type": "string"}}
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gate_id", "status", "mode", "event_id", "subject_digest"],
      "properties": {
        "gate_id": {"type": "string"},
        "status": {"enum": ["not_required", "pending", "approved", "rejected"]},
        "mode": {"type": ["string", "null"]},
        "confidence": {"type": ["string", "null"]},
        "event_id": {"type": ["string", "null"]},
        "subject_digest": {"type": ["string", "null"]},
        "operation_digest": {"type": ["string", "null"]},
        "inheritance": {"type": ["object", "null"]}
      }
    },
    "gate_event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_id", "gate_id", "decision", "actor", "source", "source_event_id", "requirement_version", "subject_files", "artifact_digest", "at"],
      "properties": {
        "event_id": {"type": "string"},
        "gate_id": {"type": "string"},
        "decision": {"enum": ["approved", "rejected"]},
        "actor": {"type": "string"},
        "source": {"type": "string"},
        "source_event_id": {"type": "string"},
        "authentication": {"enum": ["host_hmac", "local_attestation"]},
        "requirement_version": {"type": "integer", "minimum": 1},
        "digest_algorithm": {"const": "sha256-manifest-v1"},
        "subject_files": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "sha256"],
            "properties": {
              "path": {"type": "string"},
              "sha256": {"type": "string"}
            },
            "additionalProperties": false
          }
        },
        "artifact_digest": {"type": "string"},
        "at": {"type": "string", "format": "date-time"},
        "reason": {"type": ["string", "null"]},
        "affected_pages": {"type": "array", "items": {"type": "string"}},
        "revalidation_scope": {"type": "array", "items": {"type": "string"}}
      }
    },
    "git": {
      "type": "object",
      "required": ["root", "target_branch", "branch", "worktree", "head_commit", "working_tree_status", "baseline_commit", "last_checkpoint_commit", "checkpoints", "integration"],
      "properties": {
        "root": {"type": "string"},
        "target_branch": {"type": "string"},
        "branch": {"type": "string"},
        "worktree": {"type": "string"},
        "head_commit": {"type": ["string", "null"]},
        "working_tree_status": {"type": "string"},
        "baseline_commit": {"type": "string"},
        "last_checkpoint_commit": {"type": ["string", "null"]},
        "checkpoints": {"type": "array", "items": {"type": "object"}},
        "integration": {
          "type": "object",
          "required": ["status", "base_commit", "head_commit", "merges", "post_merge_checks", "delivery_commit"],
          "properties": {
            "status": {"enum": ["pending", "merging", "ready_for_verification", "verified", "conflict"]},
            "base_commit": {"type": ["string", "null"]},
            "head_commit": {"type": ["string", "null"]},
            "merges": {"type": "array", "items": {"type": "object"}},
            "post_merge_checks": {"type": "array", "items": {"type": "object"}},
            "delivery_commit": {"type": ["string", "null"]}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "routing": {
      "type": "object",
      "required": ["status", "confidence", "decided_at", "decided_by", "development", "verification"],
      "properties": {
        "status": {"enum": ["pending", "decided"]},
        "confidence": {"enum": ["low", "medium", "high"]},
        "decided_at": {"type": ["string", "null"], "format": "date-time"},
        "decided_by": {"type": ["string", "null"]},
        "risk_driver": {
          "type": ["object", "null"], "additionalProperties": false,
          "required": ["category", "statement", "evidence", "severity", "secondary_risks"],
          "properties": {
            "category": {"enum": ["localized-change", "user-experience", "business-workflow", "data-contract", "domain-rules", "system-boundary", "root-cause", "migration-compatibility", "technical-feasibility"]},
            "statement": {"type": "string", "minLength": 1},
            "evidence": {"type": "string", "minLength": 1},
            "severity": {"enum": ["low", "medium", "high"]},
            "secondary_risks": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["category", "statement", "evidence", "severity", "mapping"],
                "properties": {
                  "category": {"enum": ["localized-change", "user-experience", "business-workflow", "data-contract", "domain-rules", "system-boundary", "root-cause", "migration-compatibility", "technical-feasibility"]},
                  "statement": {"type": "string", "minLength": 1},
                  "evidence": {"type": "string", "minLength": 1},
                  "severity": {"enum": ["low", "medium", "high"]},
                  "mapping": {
                    "oneOf": [
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["kind", "flow_id"],
                        "properties": {
                          "kind": {"const": "supporting_flow"},
                          "flow_id": {"enum": ["quick-change", "product-prototype", "business-process", "data-contract", "domain-model", "architecture", "root-cause", "migration-compatibility", "technical-validation"]}
                        }
                      },
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["kind", "obligation"],
                        "properties": {
                          "kind": {"const": "verification_obligation"},
                          "obligation": {"type": "string", "minLength": 1}
                        }
                      }
                    ]
                  }
                }
              }
            }
          }
        },
        "development": {
          "type": "object",
          "required": ["main_flow", "reason", "supporting_flows", "required_outputs"],
          "properties": {
            "main_flow": {"enum": ["quick-change", "product-prototype", "business-process", "data-contract", "domain-model", "architecture", "root-cause", "migration-compatibility", "technical-validation"]},
            "reason": {"type": "string"},
            "supporting_flows": {"type": "array", "items": {"type": "string"}},
            "required_outputs": {"type": "array", "items": {"type": "string"}}
          },
          "additionalProperties": false
        },
        "verification": {"$ref": "#/$defs/verification"}
      },
      "additionalProperties": false
    },
    "verification": {
      "type": "object",
      "required": ["policy", "reason", "reused_flows", "new_flows", "executors"],
      "properties": {
        "policy": {"enum": ["self_check", "targeted", "flow"]},
        "reason": {"type": "string"},
        "reused_flows": {"type": "array", "items": {"type": "string"}},
        "new_flows": {"type": "array", "items": {"type": "string"}},
        "executors": {"type": "object", "additionalProperties": {"type": "array", "items": {"enum": ["code", "ui", "command"]}}}
      },
      "additionalProperties": false
    },
    "subflow": {
      "type": "object",
      "required": ["subflow_id", "title", "required", "acceptance_ids", "deliverable", "requirement_version", "state", "dependencies", "scope", "git", "verification", "verification_failure_roundtrips"],
      "properties": {
        "subflow_id": {"type": "string"},
        "title": {"type": "string"},
        "required": {"type": "boolean"},
        "acceptance_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "deliverable": {"type": "string"},
        "requirement_version": {"type": "integer", "minimum": 1},
        "state": {"enum": ["pending", "development_preparing", "developing", "ready_for_verification", "verifying", "passed", "failed", "blocked", "skipped"]},
        "state_reason": {"type": ["string", "null"]},
        "skip_reason": {"type": ["string", "null"]},
        "main_flow": {"type": "string"},
        "dependencies": {"type": "array", "items": {"type": "string"}},
        "scope": {"$ref": "#/$defs/scope"},
        "git": {"type": "object"},
        "verification": {"$ref": "#/$defs/verification"},
        "verification_handoff": {"type": ["object", "null"]},
        "failure_handoff": {"type": ["object", "null"]},
        "prototype_pages": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["prototype_path", "route"],
            "properties": {
              "prototype_path": {"type": "string", "minLength": 1},
              "route": {"type": "string", "minLength": 1}
            }
          }
        },
        "verification_failure_roundtrips": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "child_loop": {
      "type": "object",
      "required": ["loop_id", "required", "acceptance_ids", "deliverable", "requirement_version", "dependencies", "repository_id", "project_root", "skip_reason", "scope"],
      "properties": {
        "loop_id": {"type": "string"},
        "required": {"type": "boolean"},
        "acceptance_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "deliverable": {"type": "string"},
        "requirement_version": {"type": "integer", "minimum": 1},
        "dependencies": {"type": "array", "items": {"type": "string"}},
        "repository_id": {"type": "string"},
        "project_root": {"type": "string"},
        "loop_file": {"type": ["string", "null"]},
        "loop_uri": {"type": ["string", "null"]},
        "skip_reason": {"type": ["string", "null"]},
        "scope": {"type": "object"}
      },
      "oneOf": [
        {"properties": {"loop_file": {"type": "string"}, "loop_uri": {"type": "null"}}, "required": ["loop_file", "loop_uri"]},
        {"properties": {"loop_file": {"type": "null"}, "loop_uri": {"type": "string"}}, "required": ["loop_file", "loop_uri"]}
      ],
      "additionalProperties": false
    },
    "integration_verification": {
      "type": "object",
      "required": ["required", "reason", "decided_by", "decided_at", "dependencies", "state", "handoff", "failure_handoff", "reused_flows", "new_flows", "executors", "verification_failure_roundtrips"],
      "properties": {
        "required": {"type": "boolean"},
        "reason": {"type": "string"},
        "decided_by": {"type": "string"},
        "decided_at": {"type": "string", "format": "date-time"},
        "dependencies": {"type": "array", "items": {"type": "string"}},
        "state": {"enum": ["not_required", "pending", "ready_for_verification", "verifying", "passed", "failed", "blocked"]},
        "handoff": {"type": "object"},
        "failure_handoff": {"type": "object"},
        "reused_flows": {"type": "array", "items": {"type": "string"}},
        "new_flows": {"type": "array", "items": {"type": "string"}},
        "executors": {"type": "object"},
        "verification_failure_roundtrips": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    }
  }
}
