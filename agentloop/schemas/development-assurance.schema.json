{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentloop.local/schemas/development-assurance.schema.json",
  "title": "AgentLoop development assurance",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "loop_id", "requirement_version", "route", "obligations"],
  "properties": {
    "schema_version": {"const": 1},
    "loop_id": {"type": "string"},
    "requirement_version": {"type": "integer", "minimum": 1},
    "route": {"type": "string"},
    "obligations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["obligation_id", "source_obligation_ids", "artifact_paths", "checks", "recovery"],
        "properties": {
          "obligation_id": {"type": "string", "minLength": 1},
          "scope_id": {"type": ["string", "null"]},
          "source_obligation_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
          "artifact_paths": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
          "checks": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "gate_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "recovery": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
