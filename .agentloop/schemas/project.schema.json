{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentloop.local/schemas/project.schema.json",
  "title": "AgentLoop project.yaml",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project_id", "project_root", "approval", "verification_policy", "execution", "git"],
  "properties": {
    "schema_version": {"const": 1},
    "project_id": {"type": "string", "minLength": 1},
    "project_root": {"type": "string", "minLength": 1},
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requirement_confirmation", "routing_confirmation", "completion", "destructive_actions"],
      "properties": {
        "manual_event_authentication": {"enum": ["host_hmac", "local_attestation"]},
        "destructive_event_authentication": {"enum": ["host_hmac", "local_attestation"]},
        "requirement_confirmation": {
          "type": "object",
          "required": ["mode", "minimum_confidence", "forbidden_tags"],
          "properties": {
            "mode": {"enum": ["manual", "auto_high_confidence"]},
            "minimum_confidence": {"enum": ["high"]},
            "forbidden_tags": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
          },
          "additionalProperties": false
        },
        "routing_confirmation": {
          "type": "object",
          "required": ["mode"],
          "properties": {"mode": {"enum": ["manual", "manual_on_low_confidence"]}},
          "additionalProperties": false
        },
        "completion": {
          "type": "object",
          "required": ["mode"],
          "properties": {"mode": {"enum": ["human_acceptance", "automatic_after_verified"]}},
          "additionalProperties": false
        },
        "destructive_actions": {
          "type": "object",
          "required": ["mode"],
          "properties": {"mode": {"const": "always_manual"}},
          "additionalProperties": false
        }
      }
    },
    "verification_policy": {
      "type": "object",
      "required": ["defaults", "self_check_forbidden_tags"],
      "properties": {
        "defaults": {
          "type": "object",
          "required": ["trivial", "standard", "composite"],
          "properties": {
            "trivial": {"enum": ["self_check", "targeted", "flow"]},
            "standard": {"enum": ["targeted", "flow"]},
            "composite": {"enum": ["targeted", "flow"]}
          },
          "additionalProperties": false
        },
        "self_check_forbidden_tags": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      },
      "additionalProperties": false
    },
    "execution": {
      "type": "object",
      "required": ["workdir", "default_timeout_seconds", "max_verification_failure_roundtrips", "concurrency"],
      "properties": {
        "workdir": {"type": "string"},
        "default_timeout_seconds": {"type": "integer", "minimum": 1},
        "max_verification_failure_roundtrips": {"type": "integer", "minimum": 1},
        "concurrency": {"enum": ["separate_worktree"]}
      },
      "additionalProperties": false
    },
    "git": {
      "type": "object",
      "required": ["slice_merge_strategy", "delivery_mode"],
      "properties": {
        "slice_merge_strategy": {"const": "merge_no_ff"},
        "delivery_mode": {"enum": ["verified_integration_branch", "merge_to_target_after_verified"]}
      },
      "additionalProperties": false
    },
    "commands": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": {"type": "string"}
      },
      "default": {}
    },
    "paths": {
      "type": "object",
      "properties": {
        "source": {"type": "array", "items": {"type": "string"}},
        "tests": {"type": "array", "items": {"type": "string"}},
        "protected": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    }
  }
}
