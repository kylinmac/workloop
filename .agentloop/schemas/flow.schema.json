{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentloop.local/schemas/flow.schema.json",
  "title": "AgentLoop reusable flow",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "flow_id", "title", "executor", "status", "covers", "preconditions", "steps", "checks"],
  "properties": {
    "schema_version": {"const": 1},
    "flow_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "title": {"type": "string", "minLength": 1},
    "executor": {"enum": ["code", "ui", "command"]},
    "status": {"enum": ["active", "needs_review", "retired"]},
    "covers": {
      "type": "object",
      "properties": {
        "paths": {"type": "array", "items": {"type": "string"}},
        "interfaces": {"type": "array", "items": {"type": "string"}},
        "routes": {"type": "array", "items": {"type": "string"}},
        "db_objects": {"type": "array", "items": {"type": "string"}},
        "states": {"type": "array", "items": {"type": "string"}},
        "tags": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "preconditions": {"type": "array", "items": {"type": "string"}},
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["action", "expect"],
        "properties": {
          "step_id": {"type": "string", "minLength": 1},
          "action": {"type": "string"},
          "expect": {"type": "string"},
          "screenshot": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "checks": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "automation": {
      "type": "object",
      "required": ["path"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "not": {"pattern": "(?i)\\.md$"}
        }
      },
      "additionalProperties": false
    },
    "prototype": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "references"],
      "properties": {
        "type": {"enum": ["wireframe", "interactive", "high_fidelity"]},
        "references": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["prototype_path", "route"],
            "properties": {
              "prototype_path": {"type": "string", "minLength": 1},
              "route": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "visual_validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["viewport", "comparison", "allowed_differences", "pass_criteria"],
      "properties": {
        "viewport": {
          "type": "object",
          "additionalProperties": false,
          "required": ["width", "height"],
          "properties": {
            "width": {"type": "integer", "minimum": 1},
            "height": {"type": "integer", "minimum": 1}
          }
        },
        "comparison": {"enum": ["dom", "screenshot", "both"]},
        "allowed_differences": {"type": "array", "items": {"type": "string"}},
        "pass_criteria": {"type": "string", "minLength": 1}
      }
    },
    "coverage": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["prototype_path", "route", "region_id", "interaction_id", "acceptance_id", "automation_steps"],
        "properties": {
          "prototype_path": {"type": "string", "minLength": 1},
          "route": {"type": "string", "minLength": 1},
          "region_id": {"type": "string", "minLength": 1},
          "interaction_id": {"type": "string", "minLength": 1},
          "acceptance_id": {"type": "string", "minLength": 1},
          "automation_steps": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "source_requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["loop_id", "requirement_version"],
        "properties": {
          "loop_id": {"type": "string"},
          "requirement_version": {"type": "integer", "minimum": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"executor": {"const": "ui"}}, "required": ["executor"]},
      "then": {"required": ["automation"]}
    },
    {
      "if": {
        "anyOf": [
          {"properties": {"checks": {"contains": {"const": "visual"}}}, "required": ["checks"]},
          {"properties": {"prototype": {"properties": {"type": {"const": "high_fidelity"}}, "required": ["type"]}}, "required": ["prototype"]}
        ]
      },
      "then": {
        "required": ["prototype", "visual_validation", "coverage", "automation"],
        "properties": {
          "executor": {"const": "ui"},
          "checks": {"contains": {"const": "visual"}},
          "steps": {"items": {"required": ["step_id", "screenshot"]}}
        }
      }
    }
  ]
}
